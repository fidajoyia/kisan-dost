# Kisan Dost needs NO keys or settings to run. Everything below is optional.

# Contact e-mail sent to OpenStreetMap (place names), as their usage policy asks
NOMINATIM_EMAIL=
# Contact e-mail for Crossref (seed registrations), gives faster and more reliable answers
CROSSREF_MAILTO=
# Free OpenAlex key (openalex.org) adds more research papers to the research tab
OPENALEX_API_KEY=
# Protects the daily refresh URLs (/api/*/refresh). Vercel's cron sends it automatically.
CRON_SECRET=
# How often research is rebuilt on its own, in hours (default 6)
RESEARCH_REFRESH_HOURS=6
# Extra research RSS feeds, JSON list, e.g. [{"center":"cornell","url":"https://example.org/rss"}]
RESEARCH_FEEDS=
# Open-Meteo calls per minute the flood outlook may use (free limit is 600)
OPEN_METEO_BUDGET_PER_MIN=450
# Years used as "normal" in the flood last-year comparison
FLOOD_NORMAL_YEARS=4

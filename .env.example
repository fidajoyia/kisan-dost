# Required: your Anthropic API key (https://console.anthropic.com)
# AI for the leaf check, area warnings and research summaries. Set ONE of these:
# Claude (paid): console.anthropic.com   or   Gemini (free tier): aistudio.google.com/apikey
ANTHROPIC_API_KEY=

# Optional: model id used for leaf analysis and the 17–30 day outlook
ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional but recommended by the OpenStreetMap Nominatim usage policy:
# a contact email sent with reverse-geocoding requests
NOMINATIM_EMAIL=

# ---- Research feed (new research from the 10 centres, added automatically) ----
# Optional: free OpenAlex key (openalex.org/settings/api) adds scholarly papers from all 10 centres
OPENALEX_API_KEY=
# Optional: how often the server rebuilds the digest on its own (hours, default 6)
RESEARCH_REFRESH_HOURS=6
# Optional: protects /api/research/refresh (Vercel cron sends "Authorization: Bearer <CRON_SECRET>")
CRON_SECRET=
# Optional: extra RSS/Atom feeds, JSON list, e.g. [{"center":"icba","url":"https://example.org/rss"}]
RESEARCH_FEEDS=
# Optional: set to 0 to turn off the Claude web-search fallback used when every feed is unreachable
RESEARCH_WEB_SEARCH=1

# ---- Flood outlook (Feature 3) — all data sources are free and need no key ----
# Open-Meteo free tier: 600 calls/minute, 10,000/day. The app stays under this budget per minute.
OPEN_METEO_BUDGET_PER_MIN=450
# Years used for "normal" in the last-year comparison (more = steadier, but costs more calls once a month)
FLOOD_NORMAL_YEARS=4

# ---- Seed finder ----
# Optional: e-mail for Crossref's "polite" pool (faster, more reliable). Leave empty to skip.
CROSSREF_MAILTO=
# Set to 0 to turn off the weekly Claude web research per crop (seller, Pakistan availability, extra varieties)
SEED_WEB_RESEARCH=1

GEMINI_API_KEY=
# optional, defaults to gemini-flash-latest
GEMINI_MODEL=
